{
  "name": "weathergrid",
  "version": "0.1.0",
  "description": "Distributed IoT Weather Monitoring System - application foundation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rimraf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "gateway:run": "cross-env PYTHONPATH=services/gateway services/gateway/.venv/Scripts/python.exe -m gateway.cli",
    "gateway:test": "cross-env PYTHONPATH=services/gateway services/gateway/.venv/Scripts/python.exe -m pytest services/gateway/tests -q",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up -d postgres mosquitto",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "mqtt:subscribe": "docker compose exec -T mosquitto mosquitto_sub -h 127.0.0.1 -t weathergrid/devices/+/telemetry -v",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "sim:test": "cross-env PYTHONPATH=services/simulator services/simulator/.venv/Scripts/python.exe -m pytest services/simulator/tests -q",
    "sim:verify": "cross-env PYTHONPATH=services/simulator services/simulator/.venv/Scripts/python.exe services/simulator/tests/verify_mqtt.py",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "test": "vitest run",
    "worker:offline": "cross-env NODE_OPTIONS=--no-deprecation payload run src/workers/offline.ts",
    "worker:notifications": "cross-env NODE_OPTIONS=--no-deprecation payload run src/workers/notifications.ts",
    "verify:ingestion": "cross-env NODE_OPTIONS=--no-deprecation payload run src/verify/telemetry-ingestion.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.14.1",
    "leaflet": "1.9.4",
    "lucide-react": "^0.474.0",
    "mqtt": "5.10.4",
    "next": "15.4.11",
    "payload": "3.85.0",
    "pdfkit": "0.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "5.0.0",
    "recharts": "2.15.1",
    "sharp": "0.34.5",
    "tailwind-merge": "^2.6.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "1.9.16",
    "@types/node": "^22.19.20",
    "@types/pdfkit": "0.13.8",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.4.11",
    "postcss": "^8.5.15",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.12.4"
}
