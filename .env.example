# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is excluded via .gitignore.

# PostgreSQL connection string used by Payload's postgres adapter.
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/weathergrid

# Secret used by Payload to sign/encrypt auth tokens and cookies.
# Generate a long random value, e.g.: openssl rand -base64 32
PAYLOAD_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Publicly reachable URL of this Next.js app (used by Payload for links/CORS).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- MQTT (local Eclipse Mosquitto broker) ---
# Used by the Python simulator services in services/simulator. Payload/Next.js
# do not connect to MQTT yet — that integration arrives in a later stage.
MQTT_HOST=localhost
MQTT_PORT=1883
# Leave blank for local development, where the broker allows anonymous
# connections bound to 127.0.0.1 only. Set both for any non-loopback broker.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=weathergrid
MQTT_KEEPALIVE_SECONDS=60

# Standard Python logging level for simulator processes.
SIMULATOR_LOG_LEVEL=INFO

# --- Edge gateway -> secure Payload telemetry ingestion ---
PAYLOAD_INGEST_URL=http://localhost:3000/api/telemetry/ingest
PAYLOAD_ACKNOWLEDGEMENT_URL=http://localhost:3000/api/simulation/acknowledgements
# Create an active edge-gateway service account in Payload Admin, generate
# its native API key, and place it only in your local .env.
GATEWAY_API_KEY=
GATEWAY_BUFFER_PATH=./runtime/gateway-buffer.sqlite3
GATEWAY_BUFFER_MAX_MESSAGES=10000
GATEWAY_HTTP_TIMEOUT_SECONDS=10
GATEWAY_RETRY_MIN_SECONDS=1
GATEWAY_RETRY_MAX_SECONDS=60
GATEWAY_LOG_LEVEL=INFO

# --- Offline alert worker ---
OFFLINE_WORKER_INTERVAL_SECONDS=10
OFFLINE_WORKER_ENABLED=true

# Local academic simulation laboratory. Keep disabled unless explicitly needed.
SIMULATION_LAB_ENABLED=false
DEMO_MODE_ENABLED=false

# --- Optional email notifications (preview mode never sends real email) ---
EMAIL_PROVIDER=preview
EMAIL_FROM_NAME=WeatherGrid
EMAIL_FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=
EMAIL_REPLY_TO=
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_MIN_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600
APP_PUBLIC_URL=http://localhost:3000
